# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Production Domain & SEO Configuration (required during production `npm run build`)
# Set SITE_URL in your hosting provider environment to your real HTTPS origin (no trailing path).
# SITE_URL="https://YOUR-REAL-DOMAIN"

# Optional Google Search Console HTML Verification Token (prefer DNS TXT verification first)
# Only set if using HTML meta-tag verification; leave unset otherwise.
# GOOGLE_SITE_VERIFICATION=""

# Optional Axom Hub Contact Configuration (leave empty until real details are ready)
VITE_CONTACT_ENDPOINT=
VITE_CONTACT_EMAIL=
VITE_CONTACT_WHATSAPP=
VITE_CONTACT_WHATSAPP_URL=
VITE_OFFICE_LOCATION=

# Optional Development-Only Swarm HUD (keep false or unset in production)
# VITE_SWARM_HUD="false"
